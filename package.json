{
  "name": "@outfitting/monorepo",
  "workspaces": {
    "packages": [
      "api",
      "cli",
      "contract",
      "docs",
      "iac",
      "installer",
      "router"
    ],
    "catalogs": {
      "types": {
        "@types/node": "22.20.2"
      },
      "build": {
        "bun-types": "1.4.2",
        "@oxlint/plugins": "1.82.0",
        "oxlint": "1.82.0",
        "oxfmt": "0.67.0",
        "vitest": "5.0.0",
        "oxlint-tsgolint": "7.0.2001",
        "typescript": "7.0.2",
        "wrangler": "4.128.0"
      },
      "backend": {
        "hono": "4.13.7"
      },
      "cloudflare": {
        "@cloudflare/workers-types": "5.20260911.1"
      },
      "effect": {
        "effect": "4.0.0-rc.112",
        "@effect/tsgo": "0.45.0",
        "@effect/platform-bun": "4.0.0-rc.112",
        "@effect/platform-node": "4.0.0-rc.112",
        "@effect/platform-node-shared": "4.0.0-rc.112"
      }
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run ci:build",
    "check:global": "bun run --filter @outfitting/api --filter @outfitting/cli --filter @outfitting/contract --filter @outfitting/docs --filter @outfitting/iac check",
    "ci:build": "bun run lint:global && bun run --filter @outfitting/iac ci:build",
    "ci:deploy": "bun run --filter @outfitting/iac ci:deploy",
    "deploy": "bun run --filter @outfitting/iac deploy",
    "destroy": "bun run --filter @outfitting/iac destroy",
    "format": "oxfmt",
    "format:global": "bun run --filter @outfitting/api --filter @outfitting/cli --filter @outfitting/contract --filter @outfitting/docs --filter @outfitting/iac format",
    "lint:global": "bun run --filter @outfitting/api --filter @outfitting/cli --filter @outfitting/contract --filter @outfitting/docs --filter @outfitting/iac lint",
    "plan": "bun run --filter @outfitting/iac plan",
    "test:api": "bun run --filter @outfitting/api test",
    "test:cli": "bun run --filter @outfitting/cli test",
    "test:contract": "bun run --filter @outfitting/contract test",
    "test:router": "bun run --filter @outfitting/router test",
    "typecheck:global": "bun run --filter @outfitting/api --filter @outfitting/cli --filter @outfitting/contract --filter @outfitting/docs --filter @outfitting/iac typecheck",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:effect",
    "@oxlint/plugins": "catalog:build",
    "oxfmt": "catalog:build",
    "oxlint": "catalog:build",
    "oxlint-tsgolint": "catalog:build",
    "typescript": "catalog:build"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.112"
  }
}
