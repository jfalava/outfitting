{
  "name": "@outfitting/monorepo",
  "workspaces": {
    "packages": [
      "api",
      "cli",
      "docs",
      "iac",
      "installer",
      "router"
    ],
    "catalogs": {
      "types": {
        "@types/node": "26.4.1"
      },
      "build": {
        "@types/bun": "1.4.0",
        "@oxlint/plugins": "1.81.0",
        "oxlint": "1.81.0",
        "oxfmt": "0.66.0",
        "vitest": "4.1.11",
        "oxlint-tsgolint": "7.0.2001",
        "typescript": "7.0.2",
        "wrangler": "4.128.0"
      },
      "backend": {
        "hono": "4.13.5"
      },
      "cloudflare": {
        "@cloudflare/workers-types": "5.20260831.1"
      },
      "effect": {
        "effect": "4.0.0-rc.112",
        "@effect/platform-bun": "4.0.0-rc.112",
        "@effect/platform-node": "4.0.0-rc.112"
      },
      "iac": {
        "alchemy": "2.0.0-beta.76"
      }
    }
  },
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "plan": "bun run --cwd iac plan",
    "deploy": "bun run --cwd iac deploy",
    "destroy": "bun run --cwd iac destroy",
    "test:router": "bun run --cwd router test",
    "test:api": "bun run --cwd api test",
    "test:cli": "bun run --cwd cli test"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:build",
    "oxfmt": "catalog:build"
  }
}
