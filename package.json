{
  "name": "@outfitting/monorepo",
  "workspaces": {
    "packages": [
      "api",
      "cli",
      "docs",
      "iac",
      "installer",
      "router"
    ],
    "catalogs": {
      "types": {
        "@types/node": "26.4.1"
      },
      "build": {
        "@types/bun": "1.4.0",
        "@oxlint/plugins": "1.81.0",
        "oxlint": "1.81.0",
        "oxfmt": "0.66.0",
        "vitest": "4.1.11",
        "oxlint-tsgolint": "7.0.2001",
        "typescript": "7.0.2",
        "wrangler": "4.128.0"
      },
      "backend": {
        "hono": "4.13.5"
      },
      "cloudflare": {
        "@cloudflare/workers-types": "5.20260831.1"
      },
      "effect": {
        "effect": "4.0.0-rc.112",
        "@effect/platform-bun": "4.0.0-rc.112",
        "@effect/platform-node": "4.0.0-rc.112"
      },
      "iac": {
        "alchemy": "2.0.0-beta.76"
      }
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run ci:build",
    "check:global": "bun run --filter @outfitting/api --filter @outfitting/cli --filter @outfitting/docs --filter @outfitting/iac check",
    "ci:build": "bun run lint:global && bun run --filter @outfitting/iac ci:build",
    "ci:deploy": "bun run --filter @outfitting/iac ci:deploy",
    "deploy": "bun run --filter @outfitting/iac deploy",
    "destroy": "bun run --filter @outfitting/iac destroy",
    "format": "oxfmt",
    "format:global": "bun run --filter @outfitting/api --filter @outfitting/cli --filter @outfitting/docs --filter @outfitting/iac format",
    "lint:global": "bun run --filter @outfitting/api --filter @outfitting/cli --filter @outfitting/docs --filter @outfitting/iac lint",
    "plan": "bun run --filter @outfitting/iac plan",
    "test:api": "bun run --filter @outfitting/api test",
    "test:cli": "bun run --filter @outfitting/cli test",
    "test:router": "bun run --filter @outfitting/router test",
    "typecheck:global": "bun run --filter @outfitting/api --filter @outfitting/cli --filter @outfitting/docs --filter @outfitting/iac typecheck"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:build",
    "oxfmt": "catalog:build",
    "oxlint": "catalog:build"
  }
}
