# Shared GitHub SSH defaults. Included from ~/.ssh/config by Home Manager.
# Prefer the elliptic auth key; fall back to the legacy ed25519 name so older
# hosts keep working. IdentitiesOnly prevents offering unrelated agent keys.
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/jfalava-gitAuth-elliptic
    IdentityFile ~/.ssh/id-ed25519
    IdentitiesOnly yes
    AddKeysToAgent yes
