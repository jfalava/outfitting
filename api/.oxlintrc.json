{
  "extends": ["../.oxlintrc.json"],
  "plugins": ["react"],
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "../tools/oxlint/anti-slop/index.ts" }
  ],
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": ["*.d.ts", "**/*.d.ts"],
  "rules": {
    "no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "complexity": ["error", 6],
    "max-depth": ["error", 2],
    "max-statements": ["error", 12]
  },
  "overrides": [
    {
      "files": ["test/**/*.ts"],
      "rules": {
        "complexity": "off",
        "max-depth": "off",
        "max-statements": "off"
      }
    }
  ]
}
