{
  "name": "@outfitting/docs",
  "version": "0.18.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "check": "bun typecheck && bun lint:fix",
    "dev": "astro dev",
    "format": "prettier --write src && oxfmt",
    "format:check": "prettier --check src",
    "lint": "bun run lint:oxlint && bun run lint:astro && bun run lint:docs",
    "lint:astro": "eslint \"src/**/*.astro\"",
    "lint:astro:fix": "eslint \"src/**/*.astro\" --fix",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "lint:fix": "bun run lint:oxlint:fix && bun run lint:astro:fix && bun run lint:docs:fix",
    "lint:oxlint": "astro sync && oxlint src",
    "lint:oxlint:fix": "astro sync && oxlint src --fix",
    "preview": "astro preview",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "0.13.1",
    "@fontsource/google-sans-code": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/zilla-slab": "5.3.0",
    "@iconify-json/ph": "1.2.2",
    "astro": "7.3.2",
    "astro-icon": "1.2.0",
    "astro-og-canvas": "0.13.1",
    "canvaskit-wasm": "0.42.0",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/compiler": "4.0.0",
    "@oxlint/plugins": "catalog:build",
    "@tailwindcss/vite": "4.3.3",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "oxlint": "catalog:build",
    "oxlint-tsgolint": "catalog:build",
    "pagefind": "1.5.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "satteri": "0.10.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
