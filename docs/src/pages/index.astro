---
import DocsLayout from "../layouts/DocsLayout.astro";
import {
  getBreadcrumbs,
  getPrevNext,
  getSidebar,
} from "@cloudflare/nimbus-docs";
import { config } from "virtual:nimbus/config";

const sidebar = await getSidebar("/", { collection: "docs" });
const breadcrumbs = await getBreadcrumbs("/", { collection: "docs" });
const prevNext = await getPrevNext("/", { sidebarTree: sidebar });
---

<DocsLayout
  title={config.title}
  description={config.description}
  sidebar={sidebar}
  headings={false}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
>
  <h2 id="cli-reference">CLI reference</h2>
  <p>
    Reference for the <code>outfitting-manager</code> command-line interface on
    Windows, Linux, and macOS.
  </p>
  <p>
    <a href="/docs/cli/">Browse commands, options, and subcommands.</a>
  </p>
</DocsLayout>
