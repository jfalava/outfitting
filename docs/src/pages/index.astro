---
import DocsLayout from "../layouts/DocsLayout.astro";
import {
  getBreadcrumbs,
  getPrevNext,
  getSidebar,
} from "@cloudflare/nimbus-docs";
import { config } from "virtual:nimbus/config";

const sidebar = await getSidebar("/", { collection: "docs" });
const breadcrumbs = await getBreadcrumbs("/", { collection: "docs" });
const prevNext = await getPrevNext("/", { sidebarTree: sidebar });
---

<DocsLayout
  title={config.title}
  description={config.description}
  sidebar={sidebar}
  headings={false}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
>
  <h2 id="overview">Overview</h2>
  <p>
    Install, configure, and maintain <span class="bold">Outfitting</span> across
    Windows, WSL, and macOS.
  </p>
  <p>
    They cover the <code>outfitting-manager</code> CLI, platform setup,
    repository-managed configuration, package updates, and private fonts.
  </p>

  <h2 id="getting-started">Getting started</h2>
  <ul>
    <li>
      <a href="/docs/windows">Windows installation</a>
    </li>
    <li>
      <a href="/docs/wsl">Windows Subsystem for Linux installation</a>
    </li>
    <li>
      <a href="/docs/macos">macOS installation</a>
    </li>
    <li>
      <a href="/docs/cli">Command Line Interface</a>
    </li>
  </ul>
  <p>
    <a href="/docs/architecture">Architecture</a> covers the workers, CLI
    internals, and machine state.
  </p>
</DocsLayout>
