---
import DocsLayout from "../layouts/DocsLayout.astro";
import { getBreadcrumbs, getPrevNext, getSidebar } from "@cloudflare/nimbus-docs";
import { config } from "virtual:nimbus/config";

const sidebar = await getSidebar("/", { collection: "docs" });
const breadcrumbs = await getBreadcrumbs("/", { collection: "docs" });
const prevNext = await getPrevNext("/", { sidebarTree: sidebar });
---

<DocsLayout
  title={config.title}
  description={config.description}
  sidebar={sidebar}
  headings={false}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
>
  <h2 id="overview">Overview</h2>
  <p>
    These docs explain how to install, configure, and maintain Outfitting across Windows, Windows Subsystem for Linux, and macOS. They cover platform setup, repository-managed configuration, package updates, and the <code>outfitting-manager</code> tools for machine-local lockfile storage.
  </p>

  <h2 id="getting-started">Getting started</h2>
  <p>Choose the installation guide for your platform:</p>
  <ul>
    <li><a href="/docs/windows">Windows installation</a></li>
    <li><a href="/docs/wsl">Windows Subsystem for Linux installation</a></li>
    <li><a href="/docs/macos">macOS installation</a></li>
  </ul>
  <p>
    After installation, use the Updates page inside your platform's section to keep the configuration and packages current. The <a href="/docs/manager">Manager</a> section covers the CLI and its lockfile storage service.
  </p>
</DocsLayout>
