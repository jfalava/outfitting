{
  "extends": ["../.oxlintrc.json"],
  "plugins": [],
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "../../tools/oxlint/anti-slop/index.ts" }
  ],
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "globals": {
    "Bun": "readonly"
  },
  "ignorePatterns": ["*.d.ts", "**/*.d.ts", "test/**"],
  "rules": {
    "no-console": "off",
    "complexity": ["error", 12],
    "max-depth": ["error", 4],
    "max-statements": ["error", 40]
  }
}
