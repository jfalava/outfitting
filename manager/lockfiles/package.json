{
  "name": "@outfitting/lockfiles",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types",
    "check": "bun run lint && oxfmt --check",
    "deploy": "bun run lint && wrangler deploy",
    "dev": "bun run cf-typegen && wrangler dev",
    "fix": "bun run lint --fix && bun run format",
    "format": "oxfmt",
    "lint": "oxlint",
    "migrate:local": "wrangler d1 migrations apply outfitting-lockfiles --local",
    "migrate:remote": "wrangler d1 migrations apply outfitting-lockfiles --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "catalog:backend"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "@oxlint/plugins": "catalog:build",
    "oxfmt": "catalog:build",
    "oxlint": "catalog:build",
    "oxlint-tsgolint": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:build",
    "wrangler": "catalog:build"
  }
}
