{
  "extends": ["../.oxlintrc.json"],
  "plugins": ["react"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": ["*.d.ts", "**/*.d.ts", "test/**"],
  "rules": {
    "no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "complexity": ["error", 6],
    "max-depth": ["error", 2],
    "max-statements": ["error", 12]
  }
}
