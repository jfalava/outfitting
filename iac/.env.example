# Deploy-time values for Alchemy (copy to iac/.env — gitignored).
# Secrets Store secret OUTFITTING_LOCKFILES_TOKEN must already exist in the
# shared store (or set the value here so Alchemy can provision/adopt it).
OUTFITTING_LOCKFILES_TOKEN=

# Optional naming / docs toggle (see iac/outfitting.deploy.example.json).
# OUTFITTING_STACK_NAME=Outfitting
# OUTFITTING_API_NAME=outfitting-api
# OUTFITTING_ROUTER_NAME=outfitting-router
# OUTFITTING_DEPLOY_DOCS=1
# OUTFITTING_DOMAIN=outfitting.jfa.dev
# OUTFITTING_DEPLOY_CONFIG=./outfitting.deploy.json
